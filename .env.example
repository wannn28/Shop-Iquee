# Public storefront origin. This Next.js app is served here.
# Do not point this at WooCommerce.
NEXT_PUBLIC_SITE_URL=https://store.iquee.tech

# WooCommerce (server only). Browser code must never call /wp-json/wc/v3.
# Catalog REST and Store API requests are made from Route Handlers under /api/*.
WC_BASE_URL=https://woo.iquee.tech
WC_CONSUMER_KEY=
WC_CONSUMER_SECRET=
WC_WEBHOOK_SECRET=

# Stripe. Secret and webhook values stay on the server.
# The publishable key is safe to expose in the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
